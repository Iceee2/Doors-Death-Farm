local function isWebhookValid(webhook)
    local success, isValid = pcall(function()
        if typeof(webhook) == "string" and webhook:gsub("%s", "") ~= "" and webhook:match("https://discord.com/api/webhooks/[%d]+/[%w-_]+") then
			local body = HttpService:JSONDecode(request({
                Url = webhook,
                Method = "GET"
            }).Body)
            if not body.code and (body.id and webhook:match(body.id)) and body.token and (body.url == webhook) then
				return true
            end
        end
        return false
    end)
    return success and isValid
end

local function isTokenValid(token)
    local success, isValid = pcall(function()
        if typeof(token) == "string" and token:gsub("%s", "") ~= "" then
			return true
        end
        return false
    end)
    return success and isValid
end

